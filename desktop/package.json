{
  "name": "kairos-desktop",
  "version": "0.1.0",
  "description": "Kairos: trading journal + AI model team, paper and Kraken trading",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "author": "Kairos",
  "homepage": "https://github.com/neoonchain/agentsIA",
  "build": {
    "appId": "io.kairos.desktop",
    "productName": "Kairos",
    "artifactName": "Kairos-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": [
          "index.html",
          "tour.html",
          "manifest.webmanifest",
          "sw.js",
          "assets/**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Kairos",
      "executableName": "kairos"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neoonchain",
        "repo": "agentsIA",
        "releaseType": "release"
      }
    ]
  }
}
